[
{
"pag": 1,
"texto": "LEI Nº 11.173"
},
{
"pag": 1,
"texto": "Dispõe sobre normas para o"
},
{
"pag": 1,
"texto": "mercado livre de gás canalizado no"
},
{
"pag": 1,
"texto": "âmbito do Estado do Espírito Santo"
},
{
"pag": 1,
"texto": "e dá outras providências."
},
{
"pag": 1,
"texto": "O GOVERNADOR DO ESTADO"
},
{
"pag": 1,
"texto": "DO ESPÍRITO SANTO"
},
{
"pag": 1,
"texto": "Faço saber que a Assembleia"
},
{
"pag": 1,
"texto": "Legislativa decretou e eu sanciono"
},
{
"pag": 1,
"texto": "a seguinte Lei:"
},
{
"pag": 1,
"texto": "Art. 1º Esta Lei dispõe sobre"
},
{
"pag": 1,
"texto": "normas para o mercado livre de"
},
{
"pag": 1,
"texto": "gás canalizado no âmbito do Estado"
},
{
"pag": 1,
"texto": "do Espírito Santo e dá outras"
},
{
"pag": 1,
"texto": "providências."
},
{
"pag": 1,
"texto": "Art. 2º O agente livre de mercado"
},
{
"pag": 1,
"texto": "é o usuário do serviço público de"
},
{
"pag": 1,
"texto": "distribuição de gás canalizado que"
},
{
"pag": 1,
"texto": "se qualifique, observado o disposto"
},
{
"pag": 1,
"texto": "na legislação e em regulamento"
},
{
"pag": 1,
"texto": "expedido pela agência reguladora"
},
{
"pag": 1,
"texto": "do serviço público de distribuição de"
},
{
"pag": 1,
"texto": "gás canalizado, como consumidor"
},
{
"pag": 1,
"texto": "livre, autoprodutor ou autoimpor-"
},
{
"pag": 1,
"texto": "tador."
},
{
"pag": 1,
"texto": "§ 1º Para os fins desta Lei e da re-"
},
{
"pag": 1,
"texto": "gulamentação, ficam estabelecidas"
},
{
"pag": 1,
"texto": "as seguintes definições:"
},
{
"pag": 1,
"texto": "I - autoimportador: usuário do"
},
{
"pag": 1,
"texto": "serviço público de distribuição de"
},
{
"pag": 1,
"texto": "gás canalizado autorizado pela"
},
{
"pag": 1,
"texto": "Agência Nacional do Petróleo,"
},
{
"pag": 1,
"texto": "Gás Natural e Biocombustíveis -"
},
{
"pag": 1,
"texto": "ANP para a importação de gás e"
},
{
"pag": 1,
"texto": "que utiliza parte ou totalidade do"
},
{
"pag": 1,
"texto": "produto importado como matéria-"
},
{
"pag": 1,
"texto": "-prima ou combustível em suas"
},
{
"pag": 1,
"texto": "instalações industriais;"
},
{
"pag": 1,
"texto": "II - autoprodutor: usuário do"
},
{
"pag": 1,
"texto": "serviço público de distribuição de"
},
{
"pag": 1,
"texto": "gás canalizado autorizado pela ANP"
},
{
"pag": 1,
"texto": "a produzir, a molécula do gás, e"
},
{
"pag": 1,
"texto": "que utiliza parte ou totalidade de"
},
{
"pag": 1,
"texto": "sua produção como matéria-prima"
},
{
"pag": 1,
"texto": "ou combustível em suas instalações"
},
{
"pag": 1,
"texto": "industriais; e"
},
{
"pag": 1,
"texto": "III - consumidor livre: usuário do"
},
{
"pag": 1,
"texto": "serviço público de distribuição de"
},
{
"pag": 1,
"texto": "gás canalizado com volume de"
},
{
"pag": 1,
"texto": "consumo igual ou superior a 10.000"
},
{
"pag": 1,
"texto": "m³/dia que, conforme critérios de"
},
{
"pag": 1,
"texto": "enquadramento e condições fixados"
},
{
"pag": 1,
"texto": "nesta Lei e em regulamento, tem"
},
{
"pag": 1,
"texto": "a opção de adquirir a molécula do"
},
{
"pag": 1,
"texto": "gás diretamente do supridor."
},
{
"pag": 1,
"texto": "§ 2º Fica facultada a alteração"
},
{
"pag": 1,
"texto": "do volume de consumo definido"
},
{
"pag": 1,
"texto": "no inciso III do § 1º para fins de"
},
{
"pag": 1,
"texto": "enquadramento do usuário como"
},
{
"pag": 1,
"texto": "consumidor livre em regulamento"
},
{
"pag": 1,
"texto": "da agência reguladora."
},
{
"pag": 1,
"texto": "§ 3º A qualificação de agente como"
},
{
"pag": 1,
"texto": "autoprodutor ou autoimportador"
},
{
"pag": 1,
"texto": "condiciona-se às regras previstas"
},
{
"pag": 1,
"texto": "na legislação federal."
},
{
"pag": 1,
"texto": "Art. 3º O mercado livre de gás"
},
{
"pag": 1,
"texto": "canalizado no âmbito do Estado"
},
{
"pag": 1,
"texto": "do Espírito Santo é norteado pelas"
},
{
"pag": 1,
"texto": "seguintes diretrizes:"
},
{
"pag": 1,
"texto": "I - promoção do livre mercado;"
},
{
"pag": 1,
"texto": "II - transparência, eficiência e"
},
{
"pag": 1,
"texto": "estrutura tarifária adequada;"
},
{
"pag": 1,
"texto": "III - tratamento tarifário"
},
{
"pag": 1,
"texto": "isonômico ao consumidor livre,"
},
{
"pag": 1,
"texto": "ao autoprodutor e ao autoimpor-"
},
{
"pag": 1,
"texto": "tador, observadas as diferenças"
},
{
"pag": 1,
"texto": "estabelecidas na legislação e em"
},
{
"pag": 1,
"texto": "regulamento; e"
},
{
"pag": 1,
"texto": "IV - ampliação da rede de"
},
{
"pag": 1,
"texto": "distribuição de gás canalizado."
},
{
"pag": 1,
"texto": "Art. 4º O agente livre de"
},
{
"pag": 1,
"texto": "mercado que utilizar o sistema"
},
{
"pag": 1,
"texto": "de distribuição deverá firmar"
},
{
"pag": 1,
"texto": "contrato para a distribuição de"
},
{
"pag": 1,
"texto": "gás canalizado com a concessio-"
},
{
"pag": 1,
"texto": "nária, fazendo jus ao tratamento"
},
{
"pag": 1,
"texto": "tarifário específico da tarifa de uso"
},
{
"pag": 1,
"texto": "do sistema de distribuição de gás"
},
{
"pag": 1,
"texto": "canalizado - TUSD-GÁS."
},
{
"pag": 1,
"texto": "Art. 5º O agente livre de mercado"
},
{
"pag": 1,
"texto": "que implantar o seu ramal dedicado"
},
{
"pag": 1,
"texto": "deverá doar o ativo construído,"
},
{
"pag": 1,
"texto": "conforme regulamento, e firmar"
},
{
"pag": 1,
"texto": "contrato de operação e manutenção"
},
{
"pag": 1,
"texto": "do ramal dedicado com a conces-"
},
{
"pag": 1,
"texto": "sionária, fazendo jus a tratamento"
},
{
"pag": 1,
"texto": "tarifário específico da tarifa de uso"
},
{
"pag": 1,
"texto": "do sistema de distribuição exclusiva"
},
{
"pag": 1,
"texto": "de gás canalizado - TUSDE-GÁS."
},
{
"pag": 1,
"texto": "§ 1º A concessionária e os"
},
{
"pag": 1,
"texto": "agentes livres de mercado poderão"
},
{
"pag": 1,
"texto": "firmar, mediante mútuo acordo,"
},
{
"pag": 1,
"texto": "observado o direito de preferência"
},
{
"pag": 1,
"texto": "da concessionária em fazer o"
},
{
"pag": 1,
"texto": "investimento do ramal dedicado"
},
{
"pag": 1,
"texto": "e o disposto em regulamento,"
},
{
"pag": 1,
"texto": "contratos que permitam a esses"
},
{
"pag": 1,
"texto": "últimos:"
},
{
"pag": 1,
"texto": "I - construir gasodutos e"
},
{
"pag": 1,
"texto": "instalações de forma exclusiva;"
},
{
"pag": 1,
"texto": "II - construir gasodutos e"
},
{
"pag": 1,
"texto": "instalações de forma compartilha-"
},
{
"pag": 1,
"texto": "da com a concessionária;"
},
{
"pag": 1,
"texto": "III - arcar integralmente com o"
},
{
"pag": 1,
"texto": "custo da construção de gasodutos"
},
{
"pag": 1,
"texto": "e instalações pela concessionária;"
},
{
"pag": 1,
"texto": "e"
},
{
"pag": 1,
"texto": "IV - arcar parcialmente com o"
},
{
"pag": 1,
"texto": "custo da construção de gasodutos"
},
{
"pag": 1,
"texto": "e instalações pela concessionária."
},
{
"pag": 1,
"texto": "§ 2º A concessionária avaliará a"
},
{
"pag": 1,
"texto": "conveniência e a oportunidade na"
},
{
"pag": 1,
"texto": "celebração dos contratos previstos"
},
{
"pag": 1,
"texto": "no § 1º."
},
{
"pag": 1,
"texto": "§ 3º O agente livre de mercado"
},
{
"pag": 1,
"texto": "que não for ligado à rede de"
},
{
"pag": 1,
"texto": "distribuição ou rede local poderá"
},
{
"pag": 1,
"texto": "implantar ramal dedicado,"
},
{
"pag": 1,
"texto": "conforme regras previstas em"
},
{
"pag": 1,
"texto": "regulamento e observado o"
},
{
"pag": 1,
"texto": "disposto no § 1º."
},
{
"pag": 1,
"texto": "§ 4º O agente livre de mercado"
},
{
"pag": 1,
"texto": "que já for usuário, ativo ou"
},
{
"pag": 1,
"texto": "inativo, do sistema de distribuição"
},
{
"pag": 1,
"texto": "somente poderá implantar"
},
{
"pag": 1,
"texto": "ramal dedicado para volumes"
},
{
"pag": 1,
"texto": "adicionais à capacidade instalada"
},
{
"pag": 1,
"texto": "para o usuário, que devem ser"
},
{
"pag": 1,
"texto": "entendidos como a máxima"
},
{
"pag": 1,
"texto": "demanda contratada ao longo"
},
{
"pag": 1,
"texto": "da vida deste usuário dentro da"
},
{
"pag": 1,
"texto": "concessão, se:"
},
{
"pag": 1,
"texto": "I - observado o disposto no § 1º;"
},
{
"pag": 1,
"texto": "II - preenchidos os requisitos"
},
{
"pag": 1,
"texto": "previstos no regulamento;"
},
{
"pag": 1,
"texto": "III - não afetada a modicidade"
},
{
"pag": 1,
"texto": "tarifária dos demais usuários; e"
},
{
"pag": 1,
"texto": "IV - observado o equilíbrio econô-"
},
{
"pag": 1,
"texto": "mico-financeiro da concessão."
},
{
"pag": 1,
"texto": "§ 5º Nos casos em que o ramal"
},
{
"pag": 1,
"texto": "dedicado compreender os volumes"
},
{
"pag": 1,
"texto": "adicionais à capacidade instalada"
},
{
"pag": 1,
"texto": "para o usuário, nos termos do § 4º,"
},
{
"pag": 1,
"texto": "incidirá a TUSDE-GÁS, enquanto"
},
{
"pag": 1,
"texto": "que sobre o volume atendido pela"
},
{
"pag": 1,
"texto": "capacidade existente incidirá a"
},
{
"pag": 1,
"texto": "TUSD-GÁS."
},
{
"pag": 1,
"texto": "§ 6º Os investimentos realizados"
},
{
"pag": 1,
"texto": "pelo agente livre de mercado"
},
{
"pag": 1,
"texto": "no ramal dedicado não serão"
},
{
"pag": 1,
"texto": "considerados na base de cálculo"
},
{
"pag": 1,
"texto": "de remuneração dos ativos para"
},
{
"pag": 1,
"texto": "efeito de remuneração do capital"
},
{
"pag": 1,
"texto": "e para efeito de depreciação, na"
},
{
"pag": 1,
"texto": "fixação e revisão de tarifas."
},
{
"pag": 1,
"texto": "§ 7º Para fins de enquadramento"
},
{
"pag": 1,
"texto": "no disposto no § 4º é irrelevante"
},
{
"pag": 1,
"texto": "a circunstância de a ligação do"
},
{
"pag": 1,
"texto": "usuário à rede de distribuição ou à"
},
{
"pag": 1,
"texto": "rede local ter ocorrido no curso da"
},
{
"pag": 1,
"texto": "concessão do serviço público de"
},
{
"pag": 1,
"texto": "distribuição de gás canalizado em"
},
{
"pag": 1,
"texto": "vigor na data de publicação desta"
},
{
"pag": 1,
"texto": "Lei ou no curso da concessão já"
},
{
"pag": 1,
"texto": "extinta."
},
{
"pag": 1,
"texto": "Art. 6º As tarifas para uso do"
},
{
"pag": 1,
"texto": "sistema de distribuição a serem"
},
{
"pag": 1,
"texto": "cobradas dos agentes livres de"
},
{
"pag": 1,
"texto": "mercado obedecerão ao disposto"
},
{
"pag": 1,
"texto": "neste artigo."
},
{
"pag": 1,
"texto": "§ 1º A TUSD-GÁS será"
},
{
"pag": 1,
"texto": "estabelecida pela agência"
},
{
"pag": 1,
"texto": "reguladora e é aplicável ao"
},
{
"pag": 1,
"texto": "agente livre de mercado atendido"
},
{
"pag": 1,
"texto": "pelo sistema de distribuição, nos"
},
{
"pag": 1,
"texto": "termos do art. 4º."
},
{
"pag": 1,
"texto": "§ 2º A agência reguladora fixará"
},
{
"pag": 1,
"texto": "a TUSD-GÁS, com a garantia da"
},
{
"pag": 1,
"texto": "manutenção do equilíbrio econô-"
},
{
"pag": 1,
"texto": "mico-financeiro do contrato de"
},
{
"pag": 1,
"texto": "concessão do serviço público de"
},
{
"pag": 1,
"texto": "distribuição de gás canalizado."
},
{
"pag": 1,
"texto": "§ 3º O valor da TUSD-GÁS"
},
{
"pag": 1,
"texto": "corresponde à margem média de"
},
{
"pag": 1,
"texto": "distribuição calculada de acordo"
},
{
"pag": 1,
"texto": "com o segmento de usuário e da"
},
{
"pag": 1,
"texto": "classe de consumo do agente livre"
},
{
"pag": 1,
"texto": "de mercado na tabela de tarifas,"
},
{
"pag": 1,
"texto": "nos termos estipulados no contrato"
},
{
"pag": 1,
"texto": "de concessão do serviço público de"
},
{
"pag": 1,
"texto": "distribuição de gás canalizado e em"
},
{
"pag": 1,
"texto": "regulamento."
},
{
"pag": 1,
"texto": "§ 4º A agência reguladora fixará"
},
{
"pag": 1,
"texto": "a TUSDE-GÁS, apurada conforme"
},
{
"pag": 1,
"texto": "regulamento, que será calculada"
},
{
"pag": 1,
"texto": "pela concessionária de forma indi-"
},
{
"pag": 1,
"texto": "vidualizada para os agentes livres"
},
{
"pag": 1,
"texto": "de mercado que se enquadrarem"
},
{
"pag": 1,
"texto": "nos termos do art. 5º."
},
{
"pag": 1,
"texto": "§ 5º A parcela relativa à amortização"
},
{
"pag": 1,
"texto": "do valor da outorga, bem como"
},
{
"pag": 1,
"texto": "sua respectiva remuneração, será"
},
{
"pag": 1,
"texto": "inclusa no cálculo da TUSDE-GÁS."
},
{
"pag": 1,
"texto": "Art. 7º O regulamento, a ser"
},
{
"pag": 1,
"texto": "editado pela agência reguladora,"
},
{
"pag": 1,
"texto": "a respeito do mercado livre de"
},
{
"pag": 1,
"texto": "gás canalizado observará, dentre"
},
{
"pag": 1,
"texto": "outros, os seguintes critérios:"
},
{
"pag": 1,
"texto": "I - prazo mínimo de migração do"
},
{
"pag": 1,
"texto": "mercado cativo para o livre ou"
},
{
"pag": 1,
"texto": "vice-versa; e"
},
{
"pag": 1,
"texto": "II - vigência mínima do contrato"
},
{
"pag": 1,
"texto": "de utilização do sistema de"
},
{
"pag": 1,
"texto": "distribuição."
},
{
"pag": 1,
"texto": "Art. 8º A agência reguladora"
},
{
"pag": 1,
"texto": "disciplinará em regulamento"
},
{
"pag": 1,
"texto": "específico o procedimento para"
},
{
"pag": 1,
"texto": "conexão dos agentes livres de"
},
{
"pag": 1,
"texto": "mercado ao sistema de distribuição"
},
{
"pag": 1,
"texto": "e às fontes de suprimento."
},
{
"pag": 1,
"texto": "Art. 9º Os contratos celebrados na"
},
{
"pag": 1,
"texto": "forma do art. 5º poderão conferir"
},
{
"pag": 1,
"texto": "aos agentes livres de mercado a"
},
{
"pag": 1,
"texto": "operação e manutenção (O&M) de"
},
{
"pag": 1,
"texto": "gasodutos."
},
{
"pag": 1,
"texto": "Art. 10. A concessão do serviço"
},
{
"pag": 1,
"texto": "público de distribuição de gás"
},
{
"pag": 1,
"texto": "canalizado não confere à conces-"
},
{
"pag": 1,
"texto": "sionária direito de exclusividade na"
},
{
"pag": 1,
"texto": "comercialização de gás canalizado"
},
{
"pag": 1,
"texto": "aos usuários qualificados como"
},
{
"pag": 1,
"texto": "agentes livres de mercado."
},
{
"pag": 1,
"texto": "Art. 11. Aos agentes livres de"
},
{
"pag": 1,
"texto": "mercado poderá ser franqueada"
},
{
"pag": 1,
"texto": "pela concessionária do serviço"
},
{
"pag": 1,
"texto": "público de distribuição de gás"
},
{
"pag": 1,
"texto": "canalizado a participação conjunta"
},
{
"pag": 1,
"texto": "em chamada pública para aquisição"
},
{
"pag": 1,
"texto": "de gás, visando à obtenção de"
},
{
"pag": 1,
"texto": "preços e condições mais competitivos"
},
{
"pag": 1,
"texto": "e vantajosos."
},
{
"pag": 1,
"texto": "Art. 12. Para os agentes livres de"
},
{
"pag": 1,
"texto": "mercado a contratação de transporte"
},
{
"pag": 1,
"texto": "se dará conforme regulamento."
},
{
"pag": 1,
"texto": "Art. 13. A agência reguladora"
},
{
"pag": 1,
"texto": "expedirá os regulamentos"
},
{
"pag": 1,
"texto": "necessários à execução desta Lei no"
},
{
"pag": 1,
"texto": "prazo de 180 (cento e oitenta) dias"
},
{
"pag": 1,
"texto": "contados da sua publicação, podendo"
},
{
"pag": 1,
"texto": "ser prorrogado por igual período, em"
},
{
"pag": 1,
"texto": "caso de motivo justificado."
},
{
"pag": 1,
"texto": "Art. 14. Fica autorizada a instituição"
},
{
"pag": 1,
"texto": "de tarifa social, consubstanciada no"
},
{
"pag": 1,
"texto": "tratamento tarifário diferenciado"
},
{
"pag": 1,
"texto": "à população de baixa renda do"
},
{
"pag": 1,
"texto": "segmento residencial."
},
{
"pag": 1,
"texto": "Parágrafo único. A agência"
},
{
"pag": 1,
"texto": "reguladora disciplinará o tratamento"
},
